# Copie para .env (nunca commitado — está no .gitignore) para rodar/depurar localmente.
# Em produção (Job do Databricks), os mesmos nomes de variável são lidos via Databricks Secrets
# em vez de .env — ver config/secrets.py e o README para os scopes/keys equivalentes.

# --- SharePoint / Microsoft Graph (sharepoint_connector) ---
TENANT_ID=
CLIENT_ID=
CLIENT_SECRET=
DRIVE_ID=

# --- API Campo Análises ---
CAMPO_API_TOKEN=

# --- SQL Server (tabela station / SYS_Sample) ---
SQLSERVER_HOST=
SQLSERVER_PORT=1433
SQLSERVER_DATABASE=
SQLSERVER_USER=
SQLSERVER_PASSWORD=

# --- Webhooks Teams / Power Automate (uma variável por chave de segredo em config/projetos.py) ---
TEAMS_WEBHOOK_RESUMO_BA=
TEAMS_WEBHOOK_TECNICO_BA=
TEAMS_WEBHOOK_RESUMO_CDM=
TEAMS_WEBHOOK_TECNICO_CDM=
